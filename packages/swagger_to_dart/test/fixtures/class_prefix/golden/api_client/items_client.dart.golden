import 'package:dio/dio.dart' hide Headers;
import 'package:retrofit/retrofit.dart';

import '../models/models.dart';
part 'items_client.g.dart';

@RestApi()
abstract class ItemsClient {
  factory ItemsClient(
    Dio dio, {
    ParseErrorLogger? errorLogger,
    String? baseUrl,
  }) = _ItemsClient;

  @GET('/items')
  Future<HttpResponse<PostmanListItemsResponse>> listItems({
    @CancelRequest() CancelToken? cancelToken,
    @SendProgress() ProgressCallback? onSendProgress,
    @ReceiveProgress() ProgressCallback? onReceiveProgress,
    @Extras()
    Map<String, dynamic>? extras = const {
      'tags': ['items'],
      'operationId': 'listItems',
      'responses': {
        '200': {
          'description': 'An inline response object',
          'content': {
            'application/json': {
              'schema': {
                'type': 'object',
                'properties': {
                  'items': {'\$ref': '#/components/schemas/Items'},
                },
              },
            },
          },
        },
      },
    },
  });
  @GET('/users')
  Future<HttpResponse<PostmanBaseResponse<List<PostmanUser>>>> listUsers({
    @CancelRequest() CancelToken? cancelToken,
    @SendProgress() ProgressCallback? onSendProgress,
    @ReceiveProgress() ProgressCallback? onReceiveProgress,
    @Extras()
    Map<String, dynamic>? extras = const {
      'tags': ['items'],
      'operationId': 'listUsers',
      'responses': {
        '200': {
          'description':
              'A generic whose argument is a core type: List is not prefixed',
          'content': {
            'application/json': {
              'schema': {
                '\$ref': '#/components/schemas/BaseResponse_list_User__',
              },
            },
          },
        },
      },
    },
  });
}
