import 'package:dio/dio.dart' hide Headers;
import 'package:retrofit/retrofit.dart';

import '../models/models.dart';
part 'pets_client.g.dart';

@RestApi()
abstract class PetsClient {
  factory PetsClient(
    Dio dio, {
    ParseErrorLogger? errorLogger,
    String? baseUrl,
  }) = _PetsClient;

  @GET('/pets')
  Future<HttpResponse<List<Pet>>> listPets({
    @Query('sort') ListPetsSort sort = ListPetsSort.asc,
    @Query('level') ListPetsLevel? level,
    @CancelRequest() CancelToken? cancelToken,
    @SendProgress() ProgressCallback? onSendProgress,
    @ReceiveProgress() ProgressCallback? onReceiveProgress,
    @Extras()
    Map<String, dynamic>? extras = const {
      'tags': ['pets'],
      'operationId': 'listPets',
      'parameters': [
        {
          'name': 'sort',
          'in': 'query',
          'required': false,
          'schema': {
            'type': 'string',
            'enum': ['asc', 'desc'],
            'default': 'asc',
          },
        },
        {
          'name': 'level',
          'in': 'query',
          'required': false,
          'schema': {
            'type': 'integer',
            'enum': [1, 2],
          },
        },
      ],
      'responses': {
        '200': {
          'description': 'OK',
          'content': {
            'application/json': {
              'schema': {
                'type': 'array',
                'items': {'\$ref': '#/components/schemas/Pet'},
              },
            },
          },
        },
      },
    },
  });
}
