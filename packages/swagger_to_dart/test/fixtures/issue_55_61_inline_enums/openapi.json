{
  "openapi": "3.1.0",
  "info": { "title": "Inline enums", "version": "1.0.0" },
  "paths": {
    "/pets": {
      "get": {
        "tags": ["pets"],
        "operationId": "listPets",
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["asc", "desc"], "default": "asc" }
          },
          {
            "name": "level",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "enum": [1, 2] }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Pet" } }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pet": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["available", "sold"], "default": "available" },
          "priority": { "type": "integer", "enum": [1, 2, 3] },
          "tags": { "type": "array", "items": { "type": "string", "enum": ["cute", "old"] } },
          "state": { "$ref": "#/components/schemas/StateEnum", "default": 0 }
        }
      },
      "StateEnum": { "type": "integer", "enum": [0, 10] }
    }
  }
}
