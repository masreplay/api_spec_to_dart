import 'package:dio/dio.dart';
import 'package:retrofit/retrofit.dart';

import 'exports.dart';

/// Swagger 2.0 edge cases
///
/// ```json
/// {
///     "title": "Swagger 2.0 edge cases",
///     "version": "1.0.0"
/// }
/// ```
/// Server: `https://api.example.com/v2`
/// Server: `http://api.example.com/v2`
class BaseApiClient {
  BaseApiClient(this.dio, {this.baseUrl, this.errorLogger});

  final String? baseUrl;

  final Dio dio;

  final ParseErrorLogger? errorLogger;

  PetsClient get petsClient {
    return PetsClient(dio, baseUrl: baseUrl, errorLogger: errorLogger);
  }

  TagsClient get tagsClient {
    return TagsClient(dio, baseUrl: baseUrl, errorLogger: errorLogger);
  }

  AuthClient get authClient {
    return AuthClient(dio, baseUrl: baseUrl, errorLogger: errorLogger);
  }
}
