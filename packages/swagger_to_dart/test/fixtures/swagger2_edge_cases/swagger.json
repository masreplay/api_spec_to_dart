{
  "swagger": "2.0",
  "info": { "title": "Swagger 2.0 edge cases", "version": "1.0.0" },
  "host": "api.example.com",
  "basePath": "/v2/",
  "schemes": ["https", "http"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "tags": [{ "name": "pets", "description": "Pets" }],
  "security": [{ "apiKey": [] }],
  "securityDefinitions": {
    "basic": { "type": "basic" },
    "apiKey": { "type": "apiKey", "name": "X-API-Key", "in": "header" },
    "code": {
      "type": "oauth2",
      "flow": "accessCode",
      "authorizationUrl": "https://auth.example.com/authorize",
      "tokenUrl": "https://auth.example.com/token",
      "scopes": { "pets:read": "Read pets" }
    },
    "service": {
      "type": "oauth2",
      "flow": "application",
      "tokenUrl": "https://auth.example.com/token",
      "scopes": {}
    }
  },
  "parameters": {
    "pageSize": {
      "name": "pageSize",
      "in": "query",
      "type": "integer",
      "default": 20
    },
    "traceId": { "name": "X-Trace-Id", "in": "header", "type": "string" },
    "petBody": {
      "name": "pet",
      "in": "body",
      "required": true,
      "schema": { "$ref": "#/definitions/Pet" }
    }
  },
  "responses": {
    "NotFound": {
      "description": "Not found",
      "schema": { "$ref": "#/definitions/Error" }
    }
  },
  "paths": {
    "/pets": {
      "get": {
        "tags": ["pets"],
        "operationId": "listPets",
        "parameters": [
          { "$ref": "#/parameters/pageSize" },
          { "$ref": "#/parameters/traceId" },
          {
            "name": "tags",
            "in": "query",
            "type": "array",
            "items": { "type": "string" }
          },
          {
            "name": "ids",
            "in": "query",
            "type": "array",
            "items": { "type": "integer" },
            "collectionFormat": "multi"
          },
          {
            "name": "names",
            "in": "query",
            "type": "array",
            "items": { "type": "string" },
            "collectionFormat": "ssv"
          },
          {
            "name": "codes",
            "in": "query",
            "type": "array",
            "items": { "type": "string" },
            "collectionFormat": "pipes"
          },
          {
            "name": "flags",
            "in": "query",
            "type": "array",
            "items": { "type": "string" },
            "collectionFormat": "tsv"
          }
        ],
        "responses": {
          "200": {
            "description": "The pets",
            "headers": {
              "X-Rate-Limit": {
                "type": "integer",
                "description": "Calls left this hour"
              }
            },
            "schema": {
              "type": "array",
              "items": { "$ref": "#/definitions/Pet" }
            },
            "examples": {
              "application/json": [{ "name": "Tom", "petType": "Cat" }]
            }
          }
        }
      },
      "post": {
        "tags": ["pets"],
        "operationId": "createPet",
        "consumes": ["application/json", "application/xml"],
        "parameters": [{ "$ref": "#/parameters/petBody" }],
        "responses": {
          "201": {
            "description": "Created",
            "schema": { "$ref": "#/definitions/Pet" }
          }
        }
      }
    },
    "/pets/{petId}": {
      "parameters": [
        { "name": "petId", "in": "path", "required": true, "type": "string" }
      ],
      "get": {
        "tags": ["pets"],
        "operationId": "getPet",
        "responses": {
          "200": {
            "description": "The pet",
            "schema": { "$ref": "#/definitions/Pet" }
          },
          "404": { "$ref": "#/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["pets"],
        "operationId": "deletePet",
        "security": [{ "code": ["pets:read"] }],
        "responses": { "204": { "description": "Deleted" } }
      }
    },
    "/pets/{petId}/photo": {
      "parameters": [
        { "name": "petId", "in": "path", "required": true, "type": "string" }
      ],
      "get": {
        "tags": ["pets"],
        "operationId": "getPetPhoto",
        "produces": ["image/png"],
        "responses": {
          "200": { "description": "The photo", "schema": { "type": "file" } }
        }
      },
      "post": {
        "tags": ["pets"],
        "operationId": "uploadPetPhoto",
        "consumes": ["multipart/form-data"],
        "parameters": [
          {
            "name": "file",
            "in": "formData",
            "required": true,
            "type": "file",
            "description": "The photo"
          },
          { "name": "caption", "in": "formData", "type": "string" }
        ],
        "responses": { "204": { "description": "Uploaded" } }
      }
    },
    "/tags/{names}": {
      "get": {
        "tags": ["tags"],
        "operationId": "getTags",
        "parameters": [
          {
            "name": "names",
            "in": "path",
            "required": true,
            "type": "array",
            "items": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The tags",
            "schema": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": ["auth"],
        "operationId": "login",
        "security": [],
        "parameters": [
          {
            "name": "username",
            "in": "formData",
            "required": true,
            "type": "string"
          },
          {
            "name": "remember",
            "in": "formData",
            "type": "boolean",
            "default": false
          },
          { "name": "note", "in": "formData", "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "Logged in",
            "schema": { "$ref": "#/definitions/Session" }
          }
        }
      }
    }
  },
  "definitions": {
    "Pet": {
      "type": "object",
      "discriminator": "petType",
      "required": ["name", "petType"],
      "properties": {
        "name": { "type": "string", "x-nullable": true },
        "petType": { "type": "string" },
        "tag": { "type": "string" }
      }
    },
    "Cat": {
      "allOf": [
        { "$ref": "#/definitions/Pet" },
        {
          "type": "object",
          "properties": {
            "huntingSkill": { "type": "string", "enum": ["clueless", "lazy"] }
          }
        }
      ]
    },
    "Session": {
      "type": "object",
      "required": ["expiresAt"],
      "properties": { "expiresAt": { "type": "string", "format": "date-time" } }
    },
    "Error": {
      "type": "object",
      "required": ["message"],
      "properties": { "message": { "type": "string" } }
    }
  }
}
