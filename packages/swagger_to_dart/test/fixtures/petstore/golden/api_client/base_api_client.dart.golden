import 'package:dio/dio.dart';
import 'package:retrofit/retrofit.dart';

import 'exports.dart';

/// Petstore
///
/// ```json
/// {
///     "title": "Petstore",
///     "version": "1.0.0"
/// }
/// ```
/// Server: `https://petstore.example.com/v1`
class BaseApiClient {
  BaseApiClient(this.dio, {this.baseUrl, this.errorLogger});

  final String? baseUrl;

  final Dio dio;

  final ParseErrorLogger? errorLogger;

  PetClient get petClient {
    return PetClient(dio, baseUrl: baseUrl, errorLogger: errorLogger);
  }
}
