// PetStatus
// {
//     "type": "string",
//     "enum": [
//         "available",
//         "pending",
//         "sold"
//     ]
// }

library pet_status;

import 'exports.dart';
part 'pet_status.g.dart';

@JsonEnum(alwaysCreate: true)
enum PetStatus {
  @JsonValue('available')
  available,
  @JsonValue('pending')
  pending,
  @JsonValue('sold')
  sold;

  factory PetStatus.fromJson(String json) => PetStatus.values.firstWhere(
    (e) => e.toJson() == json,
    orElse: () => throw ArgumentError('Invalid PetStatus'),
  );

  String toJson() => _$PetStatusEnumMap[this]!;
}
