/// Error
/// {
///     "properties": {
///         "code": {
///             "type": "integer",
///             "format": "int32"
///         },
///         "message": {
///             "type": "string"
///         }
///     },
///     "type": "object",
///     "required": [
///         "code",
///         "message"
///     ]
/// }
library error;

import 'exports.dart';
part 'error.freezed.dart';
part 'error.g.dart'; // Error

@freezed
abstract class Error with _$Error {
  const Error._();

  @jsonSerializable
  const factory Error({
    /// code
    @JsonKey(name: Error.codeKey_) required int code,

    /// message
    @JsonKey(name: Error.messageKey_) required String message,
  }) = _Error;

  factory Error.fromJson(Map<String, dynamic> json) => _$ErrorFromJson(json);

  static const String codeKey_ = r'code';

  static const String messageKey_ = r'message';
}
