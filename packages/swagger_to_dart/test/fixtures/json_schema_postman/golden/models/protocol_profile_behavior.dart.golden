/// protocol-profile-behavior
///
/// ```json
/// {
///     "type": "object",
///     "description": "Set of configurations used to alter the usual behavior of sending the request"
/// }
/// ```
library;

import 'exports.dart';
part 'protocol_profile_behavior.freezed.dart';
part 'protocol_profile_behavior.g.dart';

@freezed
abstract class ProtocolProfileBehavior with _$ProtocolProfileBehavior {
  const ProtocolProfileBehavior._();

  @jsonSerializable
  const factory ProtocolProfileBehavior() = _ProtocolProfileBehavior;

  factory ProtocolProfileBehavior.fromJson(Map<String, dynamic> json) =>
      _$ProtocolProfileBehaviorFromJson(json);
}
