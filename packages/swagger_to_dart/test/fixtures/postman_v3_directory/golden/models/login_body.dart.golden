/// LoginBody
///
/// ```json
/// {
///     "properties": {
///         "username": {
///             "type": "string"
///         },
///         "avatar": {
///             "type": "string",
///             "format": "binary"
///         }
///     },
///     "type": "object"
/// }
/// ```
library;

import 'exports.dart';
part 'login_body.freezed.dart';
part 'login_body.g.dart';

@freezed
abstract class LoginBody with _$LoginBody {
  const LoginBody._();

  @jsonSerializable
  const factory LoginBody({
    /// username
    @JsonKey(name: LoginBody.usernameKey_) String? username,

    /// avatar
    @JsonKey(name: LoginBody.avatarKey_) MultipartFile? avatar,
  }) = _LoginBody;

  factory LoginBody.fromJson(Map<String, dynamic> json) =>
      _$LoginBodyFromJson(json);

  static const String usernameKey_ = 'username';

  static const String avatarKey_ = 'avatar';
}
