/// FormParameterTextValue
///
/// ```json
/// {
///     "properties": {
///         "key": {
///             "type": "string"
///         },
///         "value": {
///             "type": "string"
///         },
///         "type": {
///             "type": "string",
///             "const": "text"
///         }
///     },
///     "required": [
///         "key"
///     ]
/// }
/// ```
library;

import 'exports.dart';
part 'form_parameter_text_value.freezed.dart';
part 'form_parameter_text_value.g.dart';

@freezed
abstract class FormParameterTextValue with _$FormParameterTextValue {
  const FormParameterTextValue._();

  @jsonSerializable
  const factory FormParameterTextValue({
    /// key
    @JsonKey(name: FormParameterTextValue.keyKey_) required String key,

    /// value
    @JsonKey(name: FormParameterTextValue.valueKey_) String? value,

    /// type
    @JsonKey(name: FormParameterTextValue.typeKey_) String? type,
  }) = _FormParameterTextValue;

  factory FormParameterTextValue.fromJson(Map<String, dynamic> json) =>
      _$FormParameterTextValueFromJson(json);

  static const String keyKey_ = 'key';

  static const String valueKey_ = 'value';

  static const String typeKey_ = 'type';
}
