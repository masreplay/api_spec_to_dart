{
  "openapi": "3.1.0",
  "info": { "title": "Models only", "version": "1.0.0" },
  "components": {
    "schemas": {
      "Point": {
        "type": "object",
        "required": ["x", "y"],
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" }
        }
      },
      "Shape": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "points": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Point" }
          }
        }
      }
    }
  }
}
