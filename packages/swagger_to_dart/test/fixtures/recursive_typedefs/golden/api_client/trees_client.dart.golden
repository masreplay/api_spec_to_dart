import 'package:dio/dio.dart' hide Headers;
import 'package:retrofit/retrofit.dart';

import '../models/models.dart';
part 'trees_client.g.dart';

@RestApi()
abstract class TreesClient {
  factory TreesClient(
    Dio dio, {
    ParseErrorLogger? errorLogger,
    String? baseUrl,
  }) = _TreesClient;

  @GET('/tree')
  Future<HttpResponse<Tree>> getTree({
    @CancelRequest() CancelToken? cancelToken,
    @SendProgress() ProgressCallback? onSendProgress,
    @ReceiveProgress() ProgressCallback? onReceiveProgress,
    @Extras()
    Map<String, dynamic>? extras = const {
      'tags': ['trees'],
      'operationId': 'getTree',
      'responses': {
        '200': {
          'description': 'OK',
          'content': {
            'application/json': {
              'schema': {'\$ref': '#/components/schemas/Tree'},
            },
          },
        },
      },
    },
  });
  @PUT('/tree')
  Future<HttpResponse<A>> putNode({
    @Body() required Node requestBody,
    @CancelRequest() CancelToken? cancelToken,
    @SendProgress() ProgressCallback? onSendProgress,
    @ReceiveProgress() ProgressCallback? onReceiveProgress,
    @Extras()
    Map<String, dynamic>? extras = const {
      'tags': ['trees'],
      'operationId': 'putNode',
      'requestBody': {
        'content': {
          'application/json': {
            'schema': {'\$ref': '#/components/schemas/Node'},
          },
        },
      },
      'responses': {
        '200': {
          'description': 'OK',
          'content': {
            'application/json': {
              'schema': {'\$ref': '#/components/schemas/A'},
            },
          },
        },
      },
    },
  });
}
