/// Note
///
/// ```json
/// {
///     "properties": {
///         "id": {
///             "type": "integer",
///             "format": "int64"
///         },
///         "text": {
///             "type": "string"
///         },
///         "pinned": {
///             "type": "boolean",
///             "default": false
///         }
///     },
///     "type": "object",
///     "required": [
///         "id",
///         "text"
///     ]
/// }
/// ```
library;

import 'exports.dart';
part 'note.freezed.dart';
part 'note.g.dart';

@freezed
abstract class Note with _$Note {
  const Note._();

  @jsonSerializable
  const factory Note({
    /// id
    @JsonKey(name: Note.idKey_) required int id,

    /// text
    @JsonKey(name: Note.textKey_) required String text,

    /// pinned
    @Default(false) @JsonKey(name: Note.pinnedKey_) bool pinned,
  }) = _Note;

  factory Note.fromJson(Map<String, dynamic> json) => _$NoteFromJson(json);

  static const String idKey_ = 'id';

  static const String textKey_ = 'text';

  static const String pinnedKey_ = 'pinned';
}
