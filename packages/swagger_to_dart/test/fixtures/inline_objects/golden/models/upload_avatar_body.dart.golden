/// UploadAvatarBody
///
/// ```json
/// {
///     "properties": {
///         "file": {
///             "type": "string",
///             "format": "binary"
///         },
///         "caption": {
///             "type": "string"
///         }
///     },
///     "type": "object",
///     "required": [
///         "file"
///     ]
/// }
/// ```
library;

import 'exports.dart';
part 'upload_avatar_body.freezed.dart';
part 'upload_avatar_body.g.dart';

@freezed
abstract class UploadAvatarBody with _$UploadAvatarBody {
  const UploadAvatarBody._();

  @jsonSerializable
  const factory UploadAvatarBody({
    /// file
    @JsonKey(name: UploadAvatarBody.fileKey_) required MultipartFile file,

    /// caption
    @JsonKey(name: UploadAvatarBody.captionKey_) String? caption,
  }) = _UploadAvatarBody;

  factory UploadAvatarBody.fromJson(Map<String, dynamic> json) =>
      _$UploadAvatarBodyFromJson(json);

  static const String fileKey_ = 'file';

  static const String captionKey_ = 'caption';
}
