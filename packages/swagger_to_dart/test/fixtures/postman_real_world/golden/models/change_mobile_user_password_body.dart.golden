/// ChangeMobileUserPasswordBody
///
/// ```json
/// {
///     "properties": {
///         "old_password": {
///             "type": "string"
///         },
///         "new_password": {
///             "type": "string"
///         }
///     },
///     "type": "object"
/// }
/// ```
library;

import 'exports.dart';
part 'change_mobile_user_password_body.freezed.dart';
part 'change_mobile_user_password_body.g.dart';

@freezed
abstract class ChangeMobileUserPasswordBody
    with _$ChangeMobileUserPasswordBody {
  const ChangeMobileUserPasswordBody._();

  @jsonSerializable
  const factory ChangeMobileUserPasswordBody({
    /// oldPassword
    @JsonKey(name: ChangeMobileUserPasswordBody.oldPasswordKey_)
    String? oldPassword,

    /// newPassword
    @JsonKey(name: ChangeMobileUserPasswordBody.newPasswordKey_)
    String? newPassword,
  }) = _ChangeMobileUserPasswordBody;

  factory ChangeMobileUserPasswordBody.fromJson(Map<String, dynamic> json) =>
      _$ChangeMobileUserPasswordBodyFromJson(json);

  static const String oldPasswordKey_ = 'old_password';

  static const String newPasswordKey_ = 'new_password';
}
