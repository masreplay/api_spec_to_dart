/// ChangeAdminPasswordBody
///
/// ```json
/// {
///     "properties": {
///         "old_password": {
///             "type": "string"
///         },
///         "new_password": {
///             "type": "string"
///         }
///     },
///     "type": "object"
/// }
/// ```
library;

import 'exports.dart';
part 'change_admin_password_body.freezed.dart';
part 'change_admin_password_body.g.dart';

@freezed
abstract class ChangeAdminPasswordBody with _$ChangeAdminPasswordBody {
  const ChangeAdminPasswordBody._();

  @jsonSerializable
  const factory ChangeAdminPasswordBody({
    /// oldPassword
    @JsonKey(name: ChangeAdminPasswordBody.oldPasswordKey_) String? oldPassword,

    /// newPassword
    @JsonKey(name: ChangeAdminPasswordBody.newPasswordKey_) String? newPassword,
  }) = _ChangeAdminPasswordBody;

  factory ChangeAdminPasswordBody.fromJson(Map<String, dynamic> json) =>
      _$ChangeAdminPasswordBodyFromJson(json);

  static const String oldPasswordKey_ = 'old_password';

  static const String newPasswordKey_ = 'new_password';
}
