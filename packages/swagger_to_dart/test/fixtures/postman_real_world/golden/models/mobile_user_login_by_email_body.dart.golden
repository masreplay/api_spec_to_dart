  }) = _MobileUserLoginByEmailBody;

  factory MobileUserLoginByEmailBody.fromJson(Map<String, dynamic> json) =>
      _$MobileUserLoginByEmailBodyFromJson(json);

  static const String emailKey_ = 'email';

  static const String passwordKey_ = 'password';

  static const String deviceTokenKey_ = 'device_token';
}
