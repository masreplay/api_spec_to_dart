/// MobileUserLoginByEmailBody
///
/// ```json
/// {
///     "properties": {
///         "email": {
///             "type": "string"
///         },
///         "password": {
///             "type": "string"
///         },
///         "device_token": {
///             "type": "string"
///         }
///     },
///     "type": "object"
/// }
/// ```
library;

import 'exports.dart';
part 'mobile_user_login_by_email_body.freezed.dart';
part 'mobile_user_login_by_email_body.g.dart';

@freezed
abstract class MobileUserLoginByEmailBody with _$MobileUserLoginByEmailBody {
  const MobileUserLoginByEmailBody._();

  @jsonSerializable
  const factory MobileUserLoginByEmailBody({
    /// email
    @JsonKey(name: MobileUserLoginByEmailBody.emailKey_) String? email,

    /// password
    @JsonKey(name: MobileUserLoginByEmailBody.passwordKey_) String? password,

    /// deviceToken
    @JsonKey(name: MobileUserLoginByEmailBody.deviceTokenKey_)
