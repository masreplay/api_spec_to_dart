import 'package:dio/dio.dart' hide Headers;
import 'package:retrofit/retrofit.dart';

import '../models/models.dart';
part 'user_categories_client.g.dart';

@RestApi()
abstract class UserCategoriesClient {
  factory UserCategoriesClient(
    Dio dio, {
    ParseErrorLogger? errorLogger,
    String? baseUrl,
  }) = _UserCategoriesClient;

  @GET('/api/v1/categories/end_user')
  Future<HttpResponse> getEndUserCategories({
    @Header('jwt') String? jwt,
    @Header('Accept-Language') String? acceptLanguage,
    @CancelRequest() CancelToken? cancelToken,
    @SendProgress() ProgressCallback? onSendProgress,
    @ReceiveProgress() ProgressCallback? onReceiveProgress,
    @Extras()
    Map<String, dynamic>? extras = const {
      'tags': ['User Categories'],
      'summary': 'Get end user categories',
      'description': 'Create a new user',
      'operationId': 'getEndUserCategories',
      'parameters': [
        {
          'name': 'jwt',
          'in': 'header',
          'schema': {'type': 'string'},
        },
        {
          'name': 'Accept-Language',
          'in': 'header',
          'schema': {'type': 'string'},
        },
      ],
      'responses': {
        'default': {'description': 'Default response'},
      },
    },
  });
  @PUT('/api/v1/categories/end_user')
  Future<HttpResponse> assignCategoryToEndUser({
    @Body() required AssignCategoryToEndUserBody requestBody,
    @Header('jwt') String? jwt,
    @Header('Accept-Language') String? acceptLanguage,
    @CancelRequest() CancelToken? cancelToken,
    @SendProgress() ProgressCallback? onSendProgress,
    @ReceiveProgress() ProgressCallback? onReceiveProgress,
    @Extras()
    Map<String, dynamic>? extras = const {
      'tags': ['User Categories'],
      'summary': 'Assign category to end_user',
      'description': 'Create a new user',
      'operationId': 'assignCategoryToEndUser',
      'parameters': [
        {
          'name': 'jwt',
          'in': 'header',
          'schema': {'type': 'string'},
        },
        {
          'name': 'Accept-Language',
          'in': 'header',
          'schema': {'type': 'string'},
        },
      ],
      'requestBody': {
        'content': {
          'application/json': {
            'schema': {
              'type': 'object',
              'properties': {
                'categories': {
                  'type': 'array',
                  'items': {'type': 'integer'},
                },
              },
            },
          },
        },
      },
      'responses': {
        'default': {'description': 'Default response'},
      },
    },
  });
}
