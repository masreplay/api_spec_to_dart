import 'package:dio/dio.dart' hide Headers;
import 'package:retrofit/retrofit.dart';

import '../models/models.dart';
part 'seller_categories_client.g.dart';

@RestApi()
abstract class SellerCategoriesClient {
  factory SellerCategoriesClient(
    Dio dio, {
    ParseErrorLogger? errorLogger,
    String? baseUrl,
  }) = _SellerCategoriesClient;

  @GET('/api/v1/categories/seller')
  Future<HttpResponse> getSellerCategories({
    @Header('jwt') String? jwt,
    @Header('Accept-Language') String? acceptLanguage,
    @CancelRequest() CancelToken? cancelToken,
    @SendProgress() ProgressCallback? onSendProgress,
    @ReceiveProgress() ProgressCallback? onReceiveProgress,
    @Extras()
    Map<String, dynamic>? extras = const {
      'tags': ['Seller Categories'],
      'summary': 'Get seller categories',
      'description': 'Create a new user',
      'operationId': 'getSellerCategories',
      'parameters': [
        {
          'name': 'jwt',
          'in': 'header',
          'schema': {'type': 'string'},
        },
        {
          'name': 'Accept-Language',
          'in': 'header',
          'schema': {'type': 'string'},
        },
      ],
      'responses': {
        'default': {'description': 'Default response'},
      },
    },
  });
  @PUT('/api/v1/categories/seller')
  Future<HttpResponse> assignCategoryToSeller({
    @Body() required AssignCategoryToSellerBody requestBody,
    @Header('jwt') String? jwt,
    @Header('Accept-Language') String? acceptLanguage,
    @CancelRequest() CancelToken? cancelToken,
    @SendProgress() ProgressCallback? onSendProgress,
    @ReceiveProgress() ProgressCallback? onReceiveProgress,
    @Extras()
    Map<String, dynamic>? extras = const {
      'tags': ['Seller Categories'],
      'summary': 'Assign category to seller',
      'description': 'Create a new user',
      'operationId': 'assignCategoryToSeller',
      'parameters': [
        {
          'name': 'jwt',
          'in': 'header',
          'schema': {'type': 'string'},
        },
        {
          'name': 'Accept-Language',
          'in': 'header',
          'schema': {'type': 'string'},
        },
      ],
      'requestBody': {
        'content': {
          'application/json': {
            'schema': {
              'type': 'object',
              'properties': {
                'categories': {
                  'type': 'array',
                  'items': {'type': 'integer'},
                },
              },
            },
          },
        },
      },
      'responses': {
        'default': {'description': 'Default response'},
      },
    },
  });
}
