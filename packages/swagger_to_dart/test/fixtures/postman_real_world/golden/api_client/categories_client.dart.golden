extension CategoriesClientX on CategoriesClient {
  Future<HttpResponse> updateCategoryImage({
    required UpdateCategoryImageBody requestBody,
    @Header('jwt') String? jwt,
    @Header('Accept-Language') String? acceptLanguage,
    @Header('enctype') String? enctype,
    @CancelRequest() CancelToken? cancelToken,
    @SendProgress() ProgressCallback? onSendProgress,
    @ReceiveProgress() ProgressCallback? onReceiveProgress,
    @Extras()
    Map<String, dynamic>? extras = const {
      'tags': ['Categories'],
      'summary': 'Update category image',
      'description': 'Create a new user',
      'operationId': 'updateCategoryImage',
      'parameters': [
        {
          'name': 'jwt',
          'in': 'header',
          'schema': {'type': 'string'},
        },
        {
          'name': 'Accept-Language',
          'in': 'header',
          'schema': {'type': 'string'},
        },
        {
          'name': 'enctype',
          'in': 'header',
          'schema': {'type': 'string'},
        },
      ],
      'requestBody': {
        'content': {
          'multipart/form-data': {
            'schema': {
              'type': 'object',
              'properties': {
                'image': {'type': 'string', 'format': 'binary'},
                'category_id': {'type': 'integer'},
              },
            },
          },
        },
      },
      'responses': {
        'default': {'description': 'Default response'},
      },
    },
  }) {
    return updateCategoryImage_(
      requestBody: requestBody.toJson()
        ..removeWhere((_, value) => value == null),
      jwt: jwt,
      acceptLanguage: acceptLanguage,
      enctype: enctype,
      extras: extras,
      cancelToken: cancelToken,
      onSendProgress: onSendProgress,
      onReceiveProgress: onReceiveProgress,
    );
  }
}
