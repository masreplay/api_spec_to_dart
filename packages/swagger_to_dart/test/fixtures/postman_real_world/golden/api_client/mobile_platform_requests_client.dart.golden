          'schema': {'type': 'string'},
        },
      ],
      'requestBody': {
        'content': {
          'application/json': {
            'schema': {
              'type': 'object',
              'properties': {
                'old_password': {'type': 'string'},
                'new_password': {'type': 'string'},
              },
            },
          },
        },
      },
      'responses': {
        'default': {'description': 'Default response'},
      },
    },
  });
