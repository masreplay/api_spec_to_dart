    @Body() required ChangeMobileUserPasswordBody requestBody,
    @Header('jwt') String? jwt,
    @Header('Accept-Language') String? acceptLanguage,
    @CancelRequest() CancelToken? cancelToken,
    @SendProgress() ProgressCallback? onSendProgress,
    @ReceiveProgress() ProgressCallback? onReceiveProgress,
    @Extras()
    Map<String, dynamic>? extras = const {
      'tags': ['Mobile Platform Requests'],
      'summary': 'Change Mobile User Password',
      'description': 'Change password, if admin, no need for old password',
      'operationId': 'changeMobileUserPassword',
      'parameters': [
