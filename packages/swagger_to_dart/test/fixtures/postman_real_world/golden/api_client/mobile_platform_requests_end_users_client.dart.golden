          'in': 'query',
          'schema': {'type': 'string'},
        },
        {
          'name': 'jwt',
          'in': 'header',
          'schema': {'type': 'string'},
        },
        {
          'name': 'Accept-Language',
          'in': 'header',
          'schema': {'type': 'string'},
        },
      ],
      'responses': {
        'default': {'description': 'Default response'},
      },
    },
  });
