/// Status
///
/// ```json
/// {
///     "type": "string",
///     "enum": [
///         "active",
///         "inactive"
///     ]
/// }
/// ```
library;

import 'exports.dart';
part 'status.g.dart';

@JsonEnum(alwaysCreate: true)
enum Status {
  @JsonValue('active')
  active,
  @JsonValue('inactive')
  inactive,
  @JsonValue('unknown')
  unknown;

  factory Status.fromJson(String json) => Status.values.firstWhere(
    (e) => e.toJson() == json,
    orElse: () => Status.unknown,
  );

  String toJson() => _$StatusEnumMap[this]!;
}
