{
  "openapi": "3.1.1",
  "info": {
    "title": "Merge",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.example.com"
    }
  ],
  "tags": [
    {
      "name": "Login"
    }
  ],
  "paths": {
    "/login": {
      "post": {
        "tags": [
          "Login"
        ],
        "summary": "Login by phone",
        "description": "Logs in with a phone number.",
        "operationId": "loginByPhone",
        "parameters": [
          {
            "name": "channel",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "sms"
          },
          {
            "name": "Accept-Language",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "ar"
          },
          {
            "name": "debug",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "1"
          },
          {
            "name": "X-Device",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "android"
          },
          {
            "name": "X-Client",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "web"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "otp": {
                    "type": "integer"
                  },
                  "email": {
                    "type": "string"
                  }
                }
              },
              "examples": {
                "Login by phone": {
                  "value": {
                    "phone": "07701234567"
                  }
                },
                "Phone login": {
                  "value": {
                    "phone": "07700000000",
                    "otp": 1234
                  }
                },
                "Login by email": {
                  "value": {
                    "email": "jane@example.com"
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              },
              "examples": {
                "Login (form)": {
                  "value": {
                    "email": "jane@example.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer"
                        },
                        "phone": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "Phone login": {
                    "value": {
                      "user": {
                        "id": 1,
                        "phone": "07700000000"
                      }
                    }
                  },
                  "Email login": {
                    "value": {
                      "user": {
                        "id": 2,
                        "email": "jane@example.com"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "examples": {
                  "Wrong password": {
                    "value": {
                      "message": "Invalid credentials"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
