{
  "openapi": "3.1.1",
  "info": {
    "title": "Bookstore API",
    "description": "The worked example of Postman's collection-schema-v3 skill.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "{base_url}",
      "variables": {
        "base_url": {
          "default": "https://api.bookstore.com/v1"
        }
      }
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Sign up and log in."
    }
  ],
  "paths": {
    "/signup": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "signup",
        "operationId": "signup",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              },
              "examples": {
                "signup": {
                  "value": {
                    "email": "jane@example.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": "Default response"
          }
        },
        "security": []
      }
    },
    "/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "login",
        "operationId": "login",
        "parameters": [
          {
            "name": "X-Device",
            "in": "header",
            "description": "Client platform",
            "schema": {
              "type": "string",
              "examples": [
                "ios"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "avatar": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "examples": {
                "login": {
                  "value": {
                    "username": "jane"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": "Default response"
          }
        },
        "security": []
      }
    },
    "/books": {
      "get": {
        "summary": "get all books",
        "operationId": "getAllBooks",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Page size",
            "schema": {
              "type": "string",
              "examples": [
                "10"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer"
                      },
                      "title": {
                        "type": "string"
                      },
                      "author": {
                        "type": "string"
                      },
                      "published": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  }
                },
                "examples": {
                  "200 OK": {
                    "value": [
                      {
                        "id": 1,
                        "title": "Example Book",
                        "author": "Jane Doe",
                        "published": "2020-01-01T00:00:00Z"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "add new book",
        "operationId": "addNewBook",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "author": {
                    "type": "string"
                  }
                }
              },
              "examples": {
                "add new book": {
                  "value": {
                    "title": "Example Book",
                    "author": "Jane Doe"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": "Default response"
          }
        }
      }
    },
    "/books/{id}": {
      "get": {
        "summary": "get book by :id",
        "operationId": "getBookById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "examples": [
                "1"
              ]
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "examples": {
                  "404 Not Found": {
                    "value": {
                      "message": "No such book"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/graphql": {
      "post": {
        "summary": "search",
        "operationId": "search",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  },
                  "variables": {
                    "type": "object",
                    "properties": {
                      "q": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "examples": {
                "search": {
                  "value": {
                    "query": "query Books($q: String) { books(q: $q) { title } }",
                    "variables": {
                      "q": "dune"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": "Default response"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
