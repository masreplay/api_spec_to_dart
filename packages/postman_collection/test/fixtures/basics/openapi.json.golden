{
  "openapi": "3.1.1",
  "info": {
    "title": "Pet Store",
    "description": "A small pet store API.",
    "version": "1.2.0"
  },
  "servers": [
    {
      "url": "{baseUrl}",
      "variables": {
        "baseUrl": {
          "default": "https://petstore.example.com/v1"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Pets",
      "description": "Everything about pets"
    }
  ],
  "paths": {
    "/pets": {
      "get": {
        "tags": [
          "Pets"
        ],
        "summary": "List pets",
        "operationId": "listPets",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Page size",
            "schema": {
              "type": "string"
            },
            "example": "20"
          },
          {
            "name": "tag",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": true,
            "example": [
              "dog",
              "cat"
            ]
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "description": "Correlation id",
            "schema": {
              "type": "string"
            },
            "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-Total-Count": {
                "schema": {
                  "type": "string"
                },
                "example": "2"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer"
                      },
                      "name": {
                        "type": "string"
                      },
                      "tag": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "born": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  }
                },
                "examples": {
                  "Pets": {
                    "value": [
                      {
                        "id": 1,
                        "name": "Rex",
                        "tag": "dog",
                        "born": "2020-05-01T08:00:00Z"
                      },
                      {
                        "id": 2,
                        "name": "Tom",
                        "tag": null,
                        "born": "2021-01-10T12:30:00Z"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Pets"
        ],
        "summary": "Create pet",
        "operationId": "createPet",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "tag": {
                    "type": "string"
                  },
                  "vaccinated": {
                    "type": "boolean"
                  }
                }
              },
              "examples": {
                "Create pet": {
                  "value": {
                    "name": "Rex",
                    "tag": "dog",
                    "vaccinated": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "name": {
                      "type": "string"
                    },
                    "tag": {
                      "type": "string"
                    },
                    "vaccinated": {
                      "type": "boolean"
                    }
                  }
                },
                "examples": {
                  "Created": {
                    "value": {
                      "id": 3,
                      "name": "Rex",
                      "tag": "dog",
                      "vaccinated": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/pets/{petId}": {
      "get": {
        "tags": [
          "Pets"
        ],
        "summary": "Get pet",
        "description": "Returns one pet.",
        "operationId": "getPet",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "description": "The pet id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "1"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "name": {
                      "type": "string"
                    },
                    "tag": {
                      "type": "string"
                    }
                  }
                },
                "examples": {
                  "Found": {
                    "value": {
                      "id": 1,
                      "name": "Rex",
                      "tag": "dog"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "examples": {
                  "Missing": {
                    "value": {
                      "message": "Pet not found"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Pets"
        ],
        "summary": "Delete pet",
        "operationId": "deletePet",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "1"
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "API root",
        "operationId": "apiRoot",
        "responses": {
          "default": {
            "description": "Default response"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "default": {
            "description": "Default response"
          }
        }
      }
    }
  }
}
