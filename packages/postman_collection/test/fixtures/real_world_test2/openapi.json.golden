{
  "openapi": "3.1.1",
  "info": {
    "title": "Discounts",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "{server_name}",
      "variables": {
        "server_name": {
          "default": "http://203.0.113.10"
        }
      }
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "tags": [
    {
      "name": "Mobile Platform Requests"
    },
    {
      "name": "Mobile Platform Requests / Login"
    },
    {
      "name": "Mobile Platform Requests / Create"
    },
    {
      "name": "Mobile Platform Requests / End Users"
    },
    {
      "name": "Admin Panel Requests"
    },
    {
      "name": "Admin Panel Requests / Sellers"
    },
    {
      "name": "Admin Panel Requests / Accounts"
    },
    {
      "name": "Admin Panel Requests / Admin Users"
    },
    {
      "name": "Service  Locations"
    },
    {
      "name": "Categories"
    },
    {
      "name": "Subscriptions"
    },
    {
      "name": "ADS"
    },
    {
      "name": "Seller Categories"
    },
    {
      "name": "User Categories"
    }
  ],
  "paths": {
    "/api/v1/login/mobile_user/phone": {
      "post": {
        "tags": [
          "Mobile Platform Requests / Login"
        ],
        "summary": "Mobile User Login by phone",
        "description": "Login using username and password",
        "operationId": "mobileUserLoginByPhone",
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "ar"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              },
              "examples": {
                "Mobile User Login by phone": {
                  "value": {
                    "phone": "151452222225"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": "Default response"
          }
        },
        "security": []
      }
    },
    "/api/v1/login/mobile_user/email": {
      "post": {
        "tags": [
          "Mobile Platform Requests / Login"
        ],
        "summary": "Mobile User Login by email",
        "description": "Login using username and password",
        "operationId": "mobileUserLoginByEmail",
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "ar"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "device_token": {
                    "type": "string"
                  }
                }
              },
              "examples": {
                "Mobile User Login by email": {
                  "value": {
                    "email": "user1@example.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": "Default response"
          }
        },
        "security": []
      }
    },
    "/api/v1/users/mobile_user": {
      "post": {
        "tags": [
          "Mobile Platform Requests / Create"
        ],
        "summary": "0-Create Temp Mobile user",
        "description": "Create a new user",
        "operationId": "post0CreateTempMobileUser",
        "parameters": [
          {
            "name": "jwt",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Accept-Language",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "ar"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "string"
                  },
                  "user_type": {
                    "type": "string"
                  },
                  "full_name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "business_name": {
                    "type": "string"
                  },
                  "lang": {
                    "type": "string"
                  }
                }
              },
              "examples": {
                "0-Create Temp Mobile user": {
                  "value": {
                    "phone": "9647700000000",
                    "user_type": "end_user",
                    "full_name": "Test User"
                  }
                },
                "Seller by email": {
                  "value": {
                    "email": "user3@example.com",
                    "user_type": "seller",
                    "business_name": "Techs comp",
                    "lang": "en"
                  }
                },
                "Seller phone": {
                  "value": {
                    "phone": "07700000002",
                    "user_type": "seller",
                    "business_name": "Techs comp",
                    "lang": "en"
                  }
                },
                "End user email": {
                  "value": {
                    "email": "user4@example.com",
                    "user_type": "end_user",
                    "full_name": "Test User",
                    "lang": "en"
                  }
                },
                "End user phone": {
                  "value": {
                    "phone": "07700000001",
                    "user_type": "end_user",
                    "full_name": "Test User",
                    "lang": "en"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": "Default response"
          }
        }
      }
    },
