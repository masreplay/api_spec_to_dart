    "/api/v1/accounts/": {
      "post": {
        "tags": [
          "Admin Panel Requests / Accounts"
        ],
        "summary": "Create Account",
        "description": "Create a new user",
        "operationId": "createAccount",
        "parameters": [
          {
            "name": "jwt",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Accept-Language",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "ar"
          },
          {
            "name": "enctype",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "multipart/form-data"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "account_name": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "push_limits": {
                    "type": "integer"
                  },
                  "sms_limits": {
                    "type": "integer"
                  },
                  "expire_at": {
                    "type": "string"
                  },
                  "cities": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  }
                }
              },
              "examples": {
                "Create Account": {
                  "value": {
                    "account_name": "New Account",
                    "phone": "07700000004",
                    "email": "user2@example.com",
                    "push_limits": 0,
                    "sms_limits": 3,
                    "expire_at": "2023-07-22",
                    "cities": [
                      2,
                      5,
                      1
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": "Default response"
          }
        }
      }
    },
    "/api/v1/accounts/image": {
      "post": {
        "tags": [
          "Admin Panel Requests / Accounts"
        ],
        "summary": "Update account image (all fields are mandatory)",
        "description": "Create a new user",
        "operationId": "updateAccountImageAllFieldsAreMandatory",
        "parameters": [
          {
            "name": "jwt",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Accept-Language",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "ar"
          },
          {
            "name": "enctype",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "multipart/form-data"
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary"
                  },
                  "account_id": {
                    "type": "integer"
                  }
