            "schema": {
              "type": "string"
            },
            "example": "ar"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ملاحظة": {
                    "type": "string"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "sku": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "examples": {
                "Create order 🚀": {
                  "value": {
                    "ملاحظة": "توصيل سريع",
                    "items": [
                      {
                        "sku": "A1"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": "Default response"
          }
        }
